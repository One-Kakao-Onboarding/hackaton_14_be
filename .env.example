# ===== Application Settings =====
APP_NAME=Interior Mood Matching API
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# ===== Server Settings =====
HOST=0.0.0.0
PORT=8000
RELOAD=true

# ===== Database Settings =====
# Option 1: Full URL
# DATABASE_URL=postgresql://user:password@localhost:5432/mood_matching

# Option 2: Individual settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mood_matching
DB_USER=postgres
DB_PASSWORD=your_password_here

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ===== Redis Settings =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_CACHE_TTL=3600

# ===== AI Model Settings =====
CLIP_MODEL_NAME=ViT-B/32
DEVICE=auto
MODEL_CACHE_DIR=./models

# ===== Image Processing Settings =====
MAX_IMAGE_SIZE=1024
IMAGE_QUALITY=85

# ===== Clustering Settings =====
N_CLUSTERS=20
CLUSTER_MODEL_PATH=./models/kmeans_cluster.pkl
AUTO_RECLUSTER_THRESHOLD=1000

# ===== Matching Settings =====
DEFAULT_TOP_K=10
DEFAULT_MATCHING_STRATEGY=weighted

WEIGHT_COLOR=0.25
WEIGHT_PHYSICS=0.20
WEIGHT_STYLE=0.55

# ===== API Rate Limiting =====
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=60

# ===== Logging Settings =====
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# ===== AWS/S3 Settings (Optional) =====
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=ap-northeast-2
# S3_BUCKET_NAME=your_bucket_name

# ===== Security Settings =====
SECRET_KEY=change-this-to-a-random-secret-key-in-production
REQUIRE_API_KEY=false

# ===== Batch Processing Settings =====
MAX_BATCH_SIZE=100
BATCH_TIMEOUT=300
